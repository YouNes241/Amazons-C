#, c-format
msgid "  hint        : Get AI assistance\n"
msgstr "  hint        : Obtenir une sugestion de coup de l'ia\n"

#: src/controller/cli_commands.c:190
#, c-format
msgid "  set : Configure game options\n"
msgstr "  set : Configure les options de jeu\n"

