#: src/controller/cli_commands.c:184
#, c-format
msgid "  new         : Start a new local game\n"
msgstr "  new         : Commence une nouvelle partie locale\n"

#: src/controller/cli_commands.c:185
#, c-format
msgid "  quit        : Exit the application\n"
