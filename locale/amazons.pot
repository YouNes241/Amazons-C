#, c-format
msgid ""
"\n"
"--- Network (Client & Lobby) ---\n"
msgstr ""

#: src/controller/cli_commands.c:201
#, c-format
msgid "  join [IP:Port] [name]: Connect to a server\n"
msgstr "  join [IP:Port] [name]: Connecte au serveur choisit\n"

