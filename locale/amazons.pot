#, c-format
msgid "  show        : Display the board\n"
msgstr "  show        : Affiche le plateau\n"

#: src/controller/cli_commands.c:187
#, c-format
msgid "  undo/redo   : Cancel or replay a move\n"
msgstr "  undo/redo   : Annule / Rejoue un coup\n"

#: src/controller/cli_commands.c:188
#, c-format
msgid "  save/load   : Save or load a game state\n"
msgstr "  save/load   : Sauvegarde / Charge un état de partie\n"

