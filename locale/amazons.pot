"\n"
"--- Network (Server) ---\n"
msgstr ""

#: src/controller/cli_commands.c:193
#, c-format
msgid "  server start [port]  : Host a new server\n"
msgstr "  server start [port]  : Héberger un nouveau serveur sur le port choisit\n"

