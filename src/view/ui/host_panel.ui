<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="server_panel_box">
    <property name="orientation">vertical</property>
    <property name="spacing">20</property>
    <property name="margin-top">20</property>
    <property name="margin-bottom">30</property>
    <property name="margin-start">30</property>
    <property name="margin-end">30</property>
    
    <child>
      <object class="GtkLabel" id="server_title_label">
        <property name="label">HOST_PANEL</property>
        <property name="css-classes">title-1</property>
        <property name="margin-bottom">30</property>
      </object>
    </child>

    <child>
      <object class="GtkScrolledWindow">
        <property name="vexpand">true</property>
        <property name="hexpand">true</property>
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <child>
          <object class="GtkTextView" id="server_console_view">
            <property name="editable">false</property>
            <property name="cursor-visible">false</property>
            <property name="wrap-mode">word-char</property>
            <property name="css-classes">server-console</property> 
          </object>
        </child>
      </object>
    </child>
    
    <child>
      <object class="GtkButton" id="stop_server_btn">
        <property name="label">Shutdown Server</property>
        <property name="css-classes">destructive-action</property>
        <property name="halign">center</property>
        <property name="margin-top">10</property>
      </object>
    </child>
  </object>
</interface>