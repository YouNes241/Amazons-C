<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="singleplayer_box">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkButton" id="return_btn">
        <property name="label">Return</property>
        <property name="halign">start</property> 
        <property name="valign">start</property>
        <property name="margin-top">50</property>
        <property name="margin-start">50</property> 
      </object>
    </child>
    
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">20</property>
        <property name="halign">center</property>
        <property name="valign">center</property>
        
        <property name="vexpand">true</property> 
        
        <child>
          <object class="GtkLabel" id="title_label">
            <property name="label">SINGLEPLAYER</property>
            <property name="css-classes">title-1</property>
          </object>
        </child>
        
        <child>
          <object class="GtkButton" id="new_game_btn">
            <property name="label">New Game</property>
          </object>
        </child>
        
        <child>
          <object class="GtkButton" id="load_game_btn">
            <property name="label">Load Game</property>
          </object>
        </child>

      </object>
    </child>

  </object>
</interface>